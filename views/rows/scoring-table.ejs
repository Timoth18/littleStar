<head>
   <link rel="stylesheet" href="/public/grading.css">
</head>
<table class="score-table">
  <thead class="table-header">
    <tr>
      <th>Category</th>
      <th>Score (1–5)</th>
    </tr>
  </thead>

  <tbody>
    <% categories.forEach(cat => { %>
      <tr class="category-row">
       <td colspan="2">
          <%= cat.category_name ? cat.category_name.charAt(0).toUpperCase() + cat.category_name.slice(1) : '' %>
        </td>
      </tr>
      <% cat.items.forEach(item => { %>
        <tr>
          <td class="grading-item"> <%= item.subcategory %></td>
          <td>
          <input 
            type="number"
            class="score-input"
            min="1" max="5"
            data-id="<%= item.score_id %>"
            data-item-id="<%= item.id %>"
            data-student-class-id="<%= studentClassId %>"
            value="<%= item.score_value ?? '' %>"
            >
            </td>
          </tr>
      <% }) %>
    <% }) %>
  </tbody>
  <div class="general-notes-section">
  <h3 class="notes-header">General Notes</h3>
  <textarea 
    id="generalNotes" 
    rows="4" 
    class="notes-input"
    data-student-class-id="<%= studentClassId %>"
    placeholder="Write notes about this student here..."
  ><%= existingNote || '' %></textarea>
</div>
</table>
