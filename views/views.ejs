<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Students</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/themes/light.css" />
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
</head>
<body>

  <div class="layout">

    <!-- SIDEBAR -->
    <nav class="sidebar">
      <h2 class="logo">LittleStar</h2>
      <ul>
        <li><a href="/home">Dashboard</a></li>
        <li><a class="active" href="/views">Students</a></li>
        <li><a href="/scores">Scores</a></li>
        <li><a href="/reports">Reports</a></li>
        <li><a href="/manage-roles">Settings</a></li>
      </ul>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main">
      
      <!-- HEADER -->
      <header class="header">
        <h1>Students</h1>
      </header>

      <!-- CONTENT -->
      <section class="content">

       <div class="section-header">
        <h2 class="section-title">Student List</h2> 
      </div>
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search students..." />
        <a href="/add-student" class="btn-add">+ Add Student</a>
      </div>
      
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Age</th>
              <th>Class</th>
              <th>Contact Name</th>
              <th>Contact Number</th>
              <th>Student Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="tableBody">
          </tbody>
        </table>
         <div class="pagination" id="pagination"></div>

      </section>

    </div>
  </div>
<script>
const searchInput = document.getElementById("searchInput");
const tableBody = document.getElementById("tableBody");
let timeout = null;

async function fetchStudents(query) {
  try {
    const res = await fetch(`/search-students?q=${encodeURIComponent(query)}`);
    const html = await res.text();
    tableBody.innerHTML = html;
    initStatusTippy(); // Replace rows cleanly
  } catch (err) {
    console.error(err);
  }
}

searchInput.addEventListener("input", () => {
  clearTimeout(timeout);

  timeout = setTimeout(() => {
    const q = searchInput.value.trim();

    if (q === "") {
      window.location.reload(); // Reset table
      return;
    }
   
    fetchStudents(q);
  }, 300);
});

fetchStudents(""); // Initial load  
</script>
<script>
function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  
  toast.classList.add("show");
  setTimeout(() => {
    toast.classList.remove("show");
  }, 2000);
}
</script>
<script>
function initStatusTippy() {
  document.querySelectorAll(".status-chip").forEach(chip => {
    const id = chip.dataset.id;
    const current = chip.dataset.status;

    tippy(chip, {
      content: `
        <div class="status-options">
          <div class="status-option" data-value="Active">Active</div>
          <div class="status-option" data-value="Inactive">Inactive</div>
          <div class="status-option" data-value="Graduated">Graduated</div>
        </div>
      `,
      allowHTML: true,
      interactive: true,
      trigger: "click",
      theme: "light",
      placement: "bottom",

      onShown(instance) {
        const options = instance.popper.querySelectorAll(".status-option");
        options.forEach(opt => {
            if (opt.dataset.value === current) {
               opt.classList.add("active");
              }
          opt.onclick = async () => {
            const newStatus = opt.dataset.value;

            try {
              await fetch(`/update-status/${id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status: newStatus })
              });

              // Update UI chip
              chip.textContent = newStatus;
              chip.className = "status-chip " + newStatus.toLowerCase();
              chip.dataset.status = newStatus;
              
              showToast("Status updated!");

              instance.hide();
            } catch (err) {
              console.error("Status update failed:", err);
            }
          };
        });
      }
    });
  });
}
</script>
<script> 
  document.addEventListener("DOMContentLoaded", initStatusTippy);
</script>
<div id="toast" class="toast">Status updated!</div>
</body>
</html>
