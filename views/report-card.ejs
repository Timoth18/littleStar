<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Kindergarten Report</title>

  <style>
    @font-face {
      font-family: 'ComicSans';
      src: url("data:font/truetype;base64,<%- fontRegular %>") format('truetype');
      font-weight: 400;
      font-style: normal;
    }

    @font-face {
      font-family: 'ComicSans';
      src: url("data:font/truetype;base64,<%- fontBold %>") format('truetype');
      font-weight: 700;
      font-style: normal;
    }

    @font-face {
      font-family: 'ComicSans';
      src: url("data:font/truetype;base64,<%- fontItalic %>") format('truetype');
      font-weight: 400;
      font-style: italic;
    }

    @font-face {
      font-family: 'ComicSans';
      src: url("data:font/truetype;base64,<%- fontBoldItalic %>") format('truetype');
      font-weight: 700;
      font-style: italic;
    }

    body {
      font-family: "ComicSans", "Arial Rounded MT Bold", sans-serif;
      background: #ffffff;
      padding: 40px;
      color: #444;
    }

     h1 {
      text-align: center;
      font-size: 32px;
      color: #ff7f50;
      margin-bottom: 10px;
      margin-top: 5px;
      text-shadow: 1px 1px #fff;
    }
    
    h2.description
     {
      text-align: left;
      font-size: 16px;
      color: gray;
      margin-bottom: 10px;
      margin-top: 5px;
      text-shadow: 1px 1px #fff;
    }

    .profile-box {
      background: #fff;
      border: 3px solid #ffd28a;
      border-radius: 12px;
      padding: 20px;
      margin: 5px auto;
      width: 90%;
      font-size: 16px;
    }

     .keterangan-box {
      align-self: left;
      background: #fff;
      border: 2px dashed #ffb347;
      border-radius: 12px;
      padding: 20px;
      margin-top: 20px;
      width: fit-content;
      font-size: 16px;
    }

    .profile-row {
      margin-bottom: 6px;
    }

    .section-title {
      font-size: 24px;
      color: #4a90e2;
      margin-top: 30px;
      border-bottom: 3px dashed #4a90e2;
      padding-bottom: 5px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
    }

    /* HEADER — outer border only */
    thead th {
      background: #ffdf91;
      font-size: 18px;
      padding: 12px;
      text-align: center;

      border-top: 1px solid #bebebe;
      border-bottom: 1px solid #bebebe;
    }

    thead th:first-child {
      border-left: 1px solid #bebebe;
      border-top-left-radius: 8px;
    }

    thead th:last-child {
      border-right: 1px solid #bebebe;
      border-top-right-radius: 8px;
    }

    /* BODY */
    td {
      padding: 10px;
      font-size: 16px;
    }


    .stars {
      font-size: 18px;
      letter-spacing: 2px;
      color: #ffb400;
    }

    td.stars {
      text-align: center;
    }

    .notes-box {
      background: #fff;
      border: 2px dashed #ffb347;
      margin-top: 20px;
      padding-left: 20px;
      padding-right: 20px;
      border-radius: 10px;
      vertical-align: top;
      min-height: 100px;
      font-size: 16px;
      white-space: pre-wrap;
    }
    
    .header {
      display: flex;
      align-items: center;                  
    }

    .avoid-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .notes-wrapper{
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .notes {
      padding-top : 20px;
    }

      </style>
</head>

<body>
  <div class="header">
    <img 
    src="data:image/jpeg;base64,<%= logoBase64 %>"
    alt="Logo"
    style="height: 140px; margin-right: 10px;"
    />
    <h1>Bimba LittleStar Student Report</h1>
  </div>
  
  <!-- STUDENT PROFILE -->
  <div class="profile-box">
    <div class="profile-row"><strong>Name:</strong> <%= student.name %></div>
    <div class="profile-row"><strong>Age:</strong> <%= student.age %></div>
    <div class="profile-row"><strong>Class:</strong> <%= classInfo.name %></div>
    <div class="profile-row"><strong>Parent Contact:</strong> <%= student.contactname %> — <%= student.contactnumber %></div>
  </div>

  <h2 class="section-title">Scores</h2>

  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Score</th>
      </tr>
    </thead>
    <tbody>

      <% Object.keys(categories).forEach(catName => { %>
        <tr class="category-row">
         <td colspan="2"><%= catName.charAt(0).toUpperCase() + catName.slice(1) %></td>
        </tr>

        <% categories[catName].forEach(item => { 
            const s = item.score ?? 0;
            const maxStars = 5;
        %>
          <tr>
            <td><%= item.subcategory %></td>
              <td class="stars">
              <% for(let i = 0; i < s; i++) { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#ffb400" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="12,2 15,9 22,9 16,14 18,22 12,17 6,22 8,14 2,9 9,9"/>
                </svg>
              <% } %>
              <% for(let i = s; i < maxStars; i++) { %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#eee" xmlns="http://www.w3.org/2000/svg">
                  <polygon points="12,2 15,9 22,9 16,14 18,22 12,17 6,22 8,14 2,9 9,9"/>
                </svg>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% }) %>

    </tbody>
  </table>
  <div class="notes-wrapper">
    <div class="notes avoid-break">
      <h2 class="section-title avoid-break">General Notes</h2>  
      <div class="notes-box avoid-break">
        <%= note || "No notes provided." %>
      </div>
    </div>
  </div>

  <div class="keterangan-box" avoid-break>
     <% if (classInfo.name === 'English') { %>
    <h2 class="description">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#ffb400" xmlns="http://www.w3.org/2000/svg">
        <polygon points="12,2 15,9 22,9 16,14 18,22 12,17 6,22 8,14 2,9 9,9"/>
          </svg> Assessment Scale :</h2>
    <div class="profile-row">1 = Needs Intensive Support</div>
    <div class="profile-row">2 = Needs Stimulation</div>
    <div class="profile-row">3 = Beginning to Develop</div>
    <div class="profile-row">4 = Developing Well</div>
    <div class="profile-row">5 = Developing Very Well</div>
  <% } else { %> <h2 class="description">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#ffb400" xmlns="http://www.w3.org/2000/svg">
        <polygon points="12,2 15,9 22,9 16,14 18,22 12,17 6,22 8,14 2,9 9,9"/>
          </svg> Skala Penilaian :</h2>
    <div class="profile-row">1 = Perlu Pendampingan Intensif</div>
    <div class="profile-row">2 = Perlu Stimulasi</div>
    <div class="profile-row">3 = Mulai Berkembang</div>
    <div class="profile-row">4 = Berkembang Baik</div>
    <div class="profile-row">5 = Berkembang Sangat Baik</div>
  <% } %>
  </div>
</body>
</html>
