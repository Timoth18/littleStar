<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>LittleStar | Grading - <%= cls.name %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/grading.css">
  <style>
    .hidden { display: none; }
    .score-input { width: 60px; text-align: center; }
    .table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    .table th, .table td { border: 1px solid #ccc; padding: 0.5rem; }
    .table th { background: #f3f3f3; }
    .label { font-weight: bold; margin-right: 0.5rem; }
    .btn { padding: 0.4rem 0.8rem; background: #4f46e5; color: white; border: none; cursor: pointer; border-radius: 0.25rem; }
    .btn:hover { background: #4338ca; }
    .category-row { background: #e0e7ff; font-weight: bold; }
  </style>
</head>
<body>
<div class="layout">

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <h2 class="logo">LittleStar</h2>
    <ul>
      <li><a href="/home">Dashboard</a></li>
      <li><a href="/views">Students</a></li>
      <li><a class="active" href="/scores">Scores</a></li>
      <li><a href="/reports">Reports</a></li>
      <li><a href="/manage-roles">Settings</a></li>
    </ul>
  </nav>

  <!-- MAIN -->
  <div class="main">

    <!-- HEADER -->
    <header class="header">
      <button type="button" onclick="history.back()" class="back-button">
        ← Back
      </button>
      <h1><%= cls.name %> — Grading</h1>
    </header>

    <!-- CONTENT -->
    <section class="content">

      <!-- STUDENT DROPDOWN -->
      <label class="label" for="studentSelect">Select Student:</label>
      <div class="pretty-select">
      <div class="select-trigger" id="selectTrigger">
        -- choose --
      </div>
      
      <div class="select-options" id="selectOptions">
        <% students.forEach(sc => { %>
          <div 
          class="option"
            data-studentclassid="<%= sc.id %>"        
            data-studentid="<%= sc.student.id %>"     
            data-name="<%= sc.student.name %>"
            data-age="<%= sc.student.age %>"
            data-contactname="<%= sc.student.contactname %>"
            data-contactnumber="<%= sc.student.contactnumber %>"
            >
            <%= sc.student.name %>
          </div>
          <% }) %>
        </div>
      </div>
      <input type="hidden" id="studentSelect" name="studentSelect" />
      
      <!-- STUDENT INFO -->
      <div id="student-info" class="student-info hidden mb-4">
        <h2 id="s-name"></h2>
        <p id="s-age"></p>
        <p id="s-contactname"></p>
        <p id="s-contactnumber"></p>
        <button id="downloadPdfBtn" class="pdf-button" >Download PDF</button>
      </div>
      
      <hr class="divider hidden" id="divider">
      
      <!-- SCORE TABLE -->
      <div id="score-table-container"></div>
      
    </section>
  </div>
</div>
<script>
  const trigger = document.getElementById("selectTrigger");
  const options = document.getElementById("selectOptions");
  const hiddenInput = document.getElementById("studentSelect");
  const container = document.getElementById("score-table-container");
  function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 1800);
}

  // --- OPEN & CLOSE DROPDOWN ---
  trigger.addEventListener("click", () => {
    options.style.display = options.style.display === "block" ? "none" : "block";
  });

  // --- CLICK OUTSIDE TO CLOSE ---
  document.addEventListener("click", (e) => {
    if (!document.querySelector(".pretty-select").contains(e.target)) {
      options.style.display = "none";
    }
  });

  // --- WHEN USER SELECTS AN OPTION FROM THE CUSTOM DROPDOWN ---
  document.querySelectorAll(".option").forEach(opt => {
    opt.addEventListener("click", async () => {
      const studentClassId = opt.dataset.studentclassid;  
      const studentId = opt.dataset.studentid;
  
  document.getElementById("downloadPdfBtn").addEventListener("click", () => {
    const studentId = document.getElementById("studentSelect").value;
    window.location.href = `/export-pdf/${studentClassId}`;
  });
    
    
      // Update UI
      trigger.textContent = opt.textContent;
      hiddenInput.value = studentId;
      hiddenInput.dataset.studentclassid = studentClassId; 
      options.style.display = "none";
      
      // If empty, reset UI
      if (!studentId) {
        container.innerHTML = "";
        document.getElementById("student-info").classList.add("hidden");
        document.getElementById("divider").classList.add("hidden");
        document.getElementById("downloadPdfBtn").classList.add("hidden");
        return;
      }

      // Trigger the same behavior as your original select change
      try {
        const res = await fetch(`/scores/<%= cls.id %>/student/${studentId}`);
        const html = await res.text();

        container.innerHTML = html;
        showToast("Score table loaded");

        document.getElementById("student-info").classList.remove("hidden");
        document.getElementById("divider").classList.remove("hidden");
        document.getElementById("downloadPdfBtn").classList.remove("hidden");


        // Set name in info card
        document.getElementById("s-name").textContent = opt.textContent;
        document.getElementById("s-age").textContent = "Age: " + (opt.dataset.age ?? "-");
        document.getElementById("s-contactname").textContent = "Contact Name: " + (opt.dataset.contactname ?? "-");
        document.getElementById("s-contactnumber").textContent = "Contact Number: " + (opt.dataset.contactnumber ?? "-");

      } catch (err) {
        console.error("Error fetching score table:", err);
        showToast("Failed to load score table")
      }
    });
  });

  // --- SUPPORT REGULAR SELECT CHANGE (failsafe) ---
  hiddenInput.addEventListener("change", async function () {
    const studentId = this.value;

    if (!studentId) {
      container.innerHTML = "";
      document.getElementById("student-info").classList.add("hidden");
      document.getElementById("divider").classList.add("hidden");
      return;
    }

    try {
      const res = await fetch(`/scores/<%= cls.id %>/student/${studentId}`);
      const html = await res.text();

      container.innerHTML = html;

      document.getElementById("student-info").classList.remove("hidden");
      document.getElementById("divider").classList.remove("hidden");
      document.getElementById("s-name").textContent =
        this.options[this.selectedIndex].text;
    } catch (err) {
      console.error("Error fetching score table:", err);
    }
  });
</script>
<script>
// ---- Toast ----
function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 1800);
}

// ---- Debounce helper ----
function debounce(fn, delay = 400) {
  let timer;
  return (...args) => {
    clearTimeout(timer);
    timer = setTimeout(() => fn(...args), delay);
  };
}

const saveScore = debounce(async (input) => {
  let score = Number(input.value);

  // clamp 1–5
  if (score > 5) score = 5;
  if (score < 1) score = 1;
  input.value = score;

  const scoreId = input.dataset.id;
  const itemId = input.dataset.itemId;
  const studentClassId = input.dataset.studentClassId;

  try {
    const res = await fetch("/save-score", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        scoreId,
        itemId,
        studentClassId,
        score
      })
    });

    if (!res.ok) throw new Error();

    showToast("Saved!");
  } catch (err) {
    console.error(err);
    showToast("Failed to save");
  }
}, 500);

// ---- INPUT LISTENER (delegated) ----
document.addEventListener("input", (e) => {
  if (!e.target.classList.contains("score-input")) return;
  saveScore(e.target);
});

document.addEventListener("input", (e) => {
  if (e.target.id === "generalNotes") {
    saveNotes();
  }
});

// ---- Save Notes (debounced) ----
const saveNotes = debounce(async () => {
  const notesEl = document.getElementById("generalNotes");
  const note = notesEl.value;
  const studentClassId = notesEl.dataset.studentClassId;

  try {
    const res = await fetch("/save-notes", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ studentClassId, note })
    });

    if (!res.ok) throw new Error();

    showToast("Notes Saved!");
  } catch (err) {
    console.error(err);
    showToast("Failed to save notes");
  }
}, 600);

</script>
</body>
<div id="toast"></div>

<style>
#toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #333;
  color: white;
  padding: 12px 18px;
  border-radius: 6px;
  opacity: 0;
  transform: translateY(10px);
  transition: 0.3s ease;
  pointer-events: none;
  font-size: 14px;
}
#toast.show {
  opacity: 1;
  transform: translateY(0);
}
</style>

</html>
